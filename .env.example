# === Discord ===
DISCORD_BOT_TOKEN=your-bot-token-here

# === LLM provider ===
# Supported: anthropic, openai, google, openrouter
LLM_PROVIDER=anthropic
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-6-20250627

# === Operator identity (shown in every message footer) ===
OPERATOR_NAME=Your Name

# === Missions webhook (only needed if running the missions server) ===
# GitHub personal access token with issues:write scope on the pilots repo
GITHUB_TOKEN=your-github-token-here
GITHUB_WEBHOOK_SECRET=a-random-secret-you-choose
MISSIONS_CHANNEL_ID=your-discord-channel-id
GITHUB_PILOTS_REPO=cohabitation-project/pilots

# === The Commons (commons/server.mjs) — see commons/README.md ===
COMMONS_PUBLIC_URL=https://ashram.lastoftherealestate.com
# Shared secret for the team runner (also a GitHub Actions secret of the same name)
COMMONS_KIN_KEY=make-one-with-openssl-rand-hex-24
COMMONS_HOSTED_GLOBAL_DAILY_TOKENS=300000
# COMMONS_FROZEN=1   # kill switch: read-only

# ---- Continue with Google / GitHub (commons/lib/oauth.mjs). Optional. A provider with either line missing is off.
# Register the site with each provider first; the return addresses are
#   https://cohabi.org/auth/google/callback   and   https://cohabi.org/auth/github/callback
# The two SECRET values are passwords: put them only in the server's .env. Never in the repo, a chat or a room.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
