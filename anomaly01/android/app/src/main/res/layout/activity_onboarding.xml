<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/app_name"
            android:textColor="#50fa7b"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/onboarding_subtitle"
            android:textColor="#888888"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:textAllCaps="true" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/onboarding_description"
            android:textColor="#e0e0e0"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.4" />

        <!-- Integration level selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/onboarding_choose_level"
            android:textColor="#e0e0e0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radio_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_companion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:padding="12dp"
                android:text="@string/level_companion"
                android:textColor="#e0e0e0"
                android:textSize="14sp"
                android:buttonTint="#50fa7b" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginBottom="12dp"
                android:text="@string/level_companion_desc"
                android:textColor="#888888"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/radio_integrated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/level_integrated"
                android:textColor="#e0e0e0"
                android:textSize="14sp"
                android:buttonTint="#50fa7b" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginBottom="12dp"
                android:text="@string/level_integrated_desc"
                android:textColor="#888888"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/radio_expanded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/level_expanded"
                android:textColor="#e0e0e0"
                android:textSize="14sp"
                android:buttonTint="#50fa7b" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginBottom="12dp"
                android:text="@string/level_expanded_desc"
                android:textColor="#888888"
                android:textSize="12sp" />

        </RadioGroup>

        <!-- Summary of what the selected level means -->
        <TextView
            android:id="@+id/text_level_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="#1e1e24"
            android:textColor="#bbbbbb"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4" />

        <!-- Continue button -->
        <Button
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:text="@string/onboarding_continue"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2d8a4e" />

    </LinearLayout>

</ScrollView>
