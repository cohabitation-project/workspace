# The Commons' web server (Caddy) on the circle server, 178.105.104.131. Rendered by ops/caddy/apply.sh,
# which fills in Cloudflare's published address ranges. Edit this template, not /etc/caddy/Caddyfile.
#
# Why (door incident, 2026-11-12): cohabi.org has been behind Cloudflare since 2026-11-11. Without telling Caddy
# to trust Cloudflare, every visitor to cohabi.org looked like a Cloudflare server, so "per address" limits
# lumped strangers together and missed real floods. Now Caddy believes CF-Connecting-IP only when the request
# really comes from a Cloudflare range, and hands the app ONE X-Forwarded-For value (the real visitor), so the
# app's own `trust proxy: loopback` reads it right. A visitor can't fake it: anything they send is overwritten.
#
# No access logs are written (no `log` directive). The privacy page says so; keep it that way unless the
# council decides otherwise and the privacy page changes first.
{
	servers {
		trusted_proxies static __CF_RANGES__
		client_ip_headers CF-Connecting-IP
	}
}

(commons) {
	handle /terminal/* {
		respond "Forbidden" 403
	}
	# Cohabi Live lives at /live (Geoffrey, 2026-11-12). /voiceroom keeps working for old links.
	handle /live {
		rewrite * /voiceroom
		reverse_proxy 127.0.0.1:3201 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /voiceroom-ws {
		reverse_proxy 127.0.0.1:3201 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /voiceroom* {
		reverse_proxy 127.0.0.1:3201 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3200 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}

# One home (Geoffrey, 2026-11-12: "move all the pages to actually live Kohabi pages"). A PERSON opening a page on
# the old address is sent to the same page on cohabi.org. Machines keep working where they are, untouched:
# agents' connectors (/mcp), the API, live sockets, invite and say links, the GPT, discovery files, sign-in
# callbacks, and pictures embedded elsewhere. Moving those would break agents that already know this address.
ashram.lastoftherealestate.com {
	@page {
		method GET HEAD
		not path /mcp* /api/* /ws /ws/* /voiceroom-ws /i/* /s/* /gpt/* /.well-known/* /auth/* /images/* /m/*/face /llms.txt /robots.txt /sitemap.xml
	}
	redir @page https://cohabi.org{uri} 301
	import commons
}

# The canonical address. The voice room now works here too (it 404'd on cohabi.org before 2026-11-12).
cohabi.org, www.cohabi.org {
	import commons
}

# Cohabi mail (Stalwart, on this same server; 2026-11-13). Caddy only carries the mail server's web side: the
# admin pages, webmail and JMAP. SMTP and IMAP go to Stalwart directly on their own ports, not through Caddy.
# mail.cohabi.org must be "DNS only" (grey cloud) in Cloudflare.
mail.cohabi.org {
	reverse_proxy 127.0.0.1:8080
}

:80 {
	handle /terminal/* {
		respond "Forbidden" 403
	}
	handle {
		reverse_proxy 127.0.0.1:3200 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}
