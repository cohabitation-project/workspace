diff --git a/commons/lib/cut/cleanup.mjs b/commons/lib/cut/cleanup.mjs
new file mode 100644
index 0000000..ad0c1e1
--- /dev/null
+++ b/commons/lib/cut/cleanup.mjs
@@ -0,0 +1,83 @@
+import { lstat, readdir, unlink } from 'node:fs/promises';
+import path from 'node:path';
+
+const RENDER_NAME = /^cut_[0-9a-f]{16}\.mp4$/;
+
+/**
+ * Remove only Cut render outputs from outDir. Symlinks and all other names are
+ * deliberately left alone. Expired renders go first; if the remaining eligible
+ * files exceed maxBytes, the oldest are removed until the cap is met.
+ */
+export async function sweepRenders(outDir, {
+  maxAgeMs = 6 * 60 * 60 * 1000,
+  maxBytes = 2_000_000_000,
+  now = Date.now(),
+} = {}) {
+  if (typeof outDir !== 'string' || !outDir || !path.isAbsolute(outDir)) {
+    throw new TypeError('outDir must be an absolute directory path');
+  }
+  if (!Number.isFinite(maxAgeMs) || maxAgeMs < 0) {
+    throw new RangeError('maxAgeMs must be a finite non-negative number');
+  }
+  if (!Number.isFinite(maxBytes) || maxBytes < 0) {
+    throw new RangeError('maxBytes must be a finite non-negative number');
+  }
+  if (!Number.isFinite(now)) throw new RangeError('now must be a finite number');
+
+  let names;
+  try {
+    names = await readdir(outDir);
+  } catch (error) {
+    if (error?.code === 'ENOENT') return { deleted: 0, keptBytes: 0 };
+    throw error;
+  }
+  const candidates = [];
+  for (const name of names) {
+    if (!RENDER_NAME.test(name)) continue;
+    const filePath = path.join(outDir, name);
+    let stat;
+    try {
+      stat = await lstat(filePath);
+    } catch (error) {
+      if (error?.code === 'ENOENT') continue; // concurrently removed
+      throw error;
+    }
+    if (!stat.isFile()) continue; // in particular, never follow or remove symlinks
+    candidates.push({ name, filePath, mtimeMs: stat.mtimeMs, size: stat.size });
+  }
+
+  let deleted = 0;
+  const remove = async (entry) => {
+    try {
+      await unlink(entry.filePath); // unlink removes an entry, never follows a symlink
+      deleted++;
+      return true;
+    } catch (error) {
+      if (error?.code === 'ENOENT') return false;
+      throw error;
+    }
+  };
+
+  const cutoff = now - maxAgeMs;
+  for (const entry of candidates) {
+    if (entry.mtimeMs < cutoff) await remove(entry);
+  }
+
+  const survivors = [];
+  for (const entry of candidates) {
+    if (entry.mtimeMs < cutoff) continue;
+    try {
+      const stat = await lstat(entry.filePath);
+      if (stat.isFile()) survivors.push({ ...entry, size: stat.size, mtimeMs: stat.mtimeMs });
+    } catch (error) {
+      if (error?.code !== 'ENOENT') throw error;
+    }
+  }
+  let keptBytes = survivors.reduce((total, entry) => total + entry.size, 0);
+  survivors.sort((a, b) => a.mtimeMs - b.mtimeMs || a.name.localeCompare(b.name));
+  for (const entry of survivors) {
+    if (keptBytes <= maxBytes) break;
+    if (await remove(entry)) keptBytes -= entry.size;
+  }
+  return { deleted, keptBytes };
+}
diff --git a/commons/lib/cut/edit.mjs b/commons/lib/cut/edit.mjs
new file mode 100644
index 0000000..701c49e
--- /dev/null
+++ b/commons/lib/cut/edit.mjs
@@ -0,0 +1,146 @@
+// Cohabi Cut, Job 4: the edit list -> the planner's `tracks`.
+//
+// editToTracks(edit, { durationSec, width = 1080, height = 1920, videoSrc, musicSrc })
+//   edit = what the phone sends (see cut.js buildEdit):
+//     { trimStart, trimEnd,            seconds into the SOURCE video
+//       text?: { body, y },            one line, y = pixel offset from the frame centre on a 1080x1920 frame
+//       music?: { id, volume },        volume 0..1
+//       coverSec }                     seconds into the SOURCE video, inside the trimmed range
+//   returns the `tracks` object buildRenderPlan() takes: { main, overlay, audio }, integer ticks (120,000/s).
+//
+// Refusals (RangeError/TypeError with a plain message; the route turns them into a 400):
+//   not an object; trimStart/trimEnd not finite numbers; trimEnd <= trimStart; trimStart < 0 or trimEnd > durationSec;
+//   text body not a string, over 80 characters, or containing a line break / control character;
+//   text.y not finite, or the line would leave the frame; a line that cannot fit the frame width at 16 px;
+//   music.id not a non-empty string; music.volume not a number from 0 to 1;
+//   coverSec not a finite number inside [trimStart, trimEnd].
+//
+// PATHS: `videoSrc` / `musicSrc` are SERVER-SIDE file paths the route has already looked up from the client's
+// video id and music id. The client never supplies a path. If omitted they default to the placeholder
+// names "main-video" and "music-<id>", which ffmpeg cannot open: the route must pass real paths.
+//
+// CAPTION CONVENTION: the planner on main (commons/lib/cut/plan.mjs) draws a Words caption at x/y = TOP-LEFT
+// source pixels with fontSize in pixels, and does not wrap. So this module converts: it picks a font size that
+// fits ONE line (<= 84% of the frame width by the DejaVu Sans width table in wrap.mjs, between 16 px and ~4% of
+// the frame height), centres the line horizontally by that estimate, and puts its vertical centre at
+// height/2 + y * height/1920. The estimate is for DejaVu Sans; the server's default `sans` may be another face
+// (Inter on one box), so the line may sit a little off-centre there. That is a known, unmeasured limit.
+//
+// Import path: written to run from teams/cut/editor/. When placed at commons/lib/cut/edit.mjs change
+// "../render/wrap.mjs" to "./wrap.mjs" (wrap.mjs has no imports of its own and must be placed with it).
+
+import { estimateTextWidth, LINE_HEIGHT_FACTOR } from "./wrap.mjs";
+
+export const TICKS_PER_SECOND = 120_000;
+export const MAX_TEXT_CHARS = 80;
+export const UI_FRAME_HEIGHT = 1920; // the frame height the phone's y offsets (-540 / 0 / +540) assume
+export const MIN_FONT_PX = 16;
+export const WIDTH_FRACTION = 0.84;
+
+const ticks = (sec) => Math.round(sec * TICKS_PER_SECOND);
+
+function finite(name, v) {
+	if (typeof v !== "number" || !Number.isFinite(v)) throw new TypeError(`${name} must be a finite number, got ${String(v)}`);
+	return v;
+}
+
+function textElement(body, y, { durationTicks, width, height }) {
+	if (typeof body !== "string") throw new TypeError("text.body must be a string");
+	if (body.length > MAX_TEXT_CHARS) throw new RangeError(`text must be at most ${MAX_TEXT_CHARS} characters, got ${body.length}`);
+	if (/[\u0000-\u001f\u007f\u2028\u2029]/.test(body)) throw new RangeError("text must be one line: no line breaks or control characters");
+	const yOffset = finite("text.y", y ?? 0);
+	let px = Math.max(MIN_FONT_PX, Math.round(height * 0.04));
+	const maxWidth = width * WIDTH_FRACTION;
+	while (px > MIN_FONT_PX && estimateTextWidth(body, px) > maxWidth) px--;
+	const w = estimateTextWidth(body, px);
+	if (w > maxWidth) throw new RangeError(`text is too long to fit on one line of a ${width}px frame at ${MIN_FONT_PX}px`);
+	const lh = Math.ceil(px * LINE_HEIGHT_FACTOR);
+	const centreY = height / 2 + (yOffset * height) / UI_FRAME_HEIGHT;
+	if (centreY - lh / 2 < 0 || centreY + lh / 2 > height) throw new RangeError(`text at y offset ${yOffset} would leave the ${height}px frame`);
+	return {
+		id: "cut-caption-1",
+		type: "text",
+		name: "Caption",
+		startTime: 0,
+		duration: durationTicks,
+		trimStart: 0,
+		trimEnd: 0,
+		params: {
+			content: body,
+			fontSize: px,
+			color: "white",
+			"transform.positionX": Math.round((width - w) / 2),
+			"transform.positionY": Math.round(centreY - lh / 2),
+		},
+	};
+}
+
+export function editToTracks(edit, { durationSec, width = 1080, height = 1920, videoSrc = "main-video", musicSrc } = {}) {
+	if (!edit || typeof edit !== "object" || Array.isArray(edit)) throw new TypeError("edit must be an object");
+	finite("durationSec", durationSec);
+	if (durationSec <= 0) throw new RangeError("durationSec must be greater than 0");
+	const trimStart = finite("trimStart", edit.trimStart);
+	const trimEnd = finite("trimEnd", edit.trimEnd);
+	if (trimEnd <= trimStart) throw new RangeError(`trimEnd (${trimEnd}) must be greater than trimStart (${trimStart})`);
+	if (trimStart < 0 || trimEnd > durationSec) throw new RangeError(`trim ${trimStart}..${trimEnd} must lie within 0..${durationSec} seconds of the video`);
+	const coverSec = finite("coverSec", edit.coverSec);
+	if (coverSec < trimStart || coverSec > trimEnd) throw new RangeError(`coverSec ${coverSec} must lie inside the trimmed range ${trimStart}..${trimEnd}`);
+
+	const startTick = ticks(trimStart);
+	const durationTicks = ticks(trimEnd) - startTick;
+	if (durationTicks < 1) throw new RangeError("the trimmed clip is shorter than one tick");
+
+	const tracks = {
+		overlay: [],
+		main: {
+			id: "main",
+			type: "video",
+			elements: [{
+				id: "cut-main-1",
+				type: "video",
+				startTime: 0,
+				duration: durationTicks,
+				trimStart: startTick,
+				sourceDuration: ticks(durationSec),
+				params: { src: videoSrc },
+			}],
+		},
+		audio: [],
+	};
+
+	if (edit.text !== undefined && edit.text !== null) {
+		if (typeof edit.text !== "object" || Array.isArray(edit.text)) throw new TypeError("text must be an object { body, y }");
+		// A blank body means "no text" (the page omits it, but a stray empty string must not draw an empty caption).
+		if (typeof edit.text.body === "string" && edit.text.body.trim() === "") {
+			// nothing to draw
+		} else {
+			tracks.overlay.push({ id: "words", name: "Words", type: "text", hidden: false, elements: [textElement(edit.text.body, edit.text.y, { durationTicks, width, height })] });
+		}
+	}
+
+	if (edit.music !== undefined && edit.music !== null) {
+		const m = edit.music;
+		if (typeof m !== "object" || Array.isArray(m)) throw new TypeError("music must be an object { id, volume }");
+		if (typeof m.id !== "string" || m.id.length === 0) throw new TypeError("music.id must be a non-empty string");
+		const volume = finite("music.volume", m.volume);
+		if (volume < 0 || volume > 1) throw new RangeError(`music.volume must be from 0 to 1, got ${volume}`);
+		tracks.audio.push({
+			id: "music",
+			type: "audio",
+			elements: [{
+				id: "cut-music-1",
+				type: "audio",
+				startTime: 0,
+				duration: durationTicks,
+				trimStart: 0,
+				params: { src: musicSrc ?? `music-${m.id}`, volume },
+			}],
+		});
+	}
+	return tracks;
+}
+
+/** Where the cover frame sits in the RENDERED video, in seconds (coverSec is in the source video). */
+export function coverOffsetSec(edit) {
+	return finite("coverSec", edit.coverSec) - finite("trimStart", edit.trimStart);
+}
diff --git a/commons/lib/cut/render-child.mjs b/commons/lib/cut/render-child.mjs
new file mode 100644
index 0000000..6f43fcd
--- /dev/null
+++ b/commons/lib/cut/render-child.mjs
@@ -0,0 +1,10 @@
+// Child process for POST /api/cut/render: runs renderEditJob (which uses spawnSync) OFF the server's event loop.
+// Started by forkRenderJob in wire.mjs. Gets the job over IPC, answers once, exits.
+import { renderEditJob } from "./render-job.mjs";
+
+process.once("message", (job) => {
+	let out;
+	try { out = { ok: true, result: renderEditJob(job) }; }
+	catch (e) { out = { ok: false, name: String(e?.name || "Error"), message: String(e?.message || e) }; }
+	process.send(out, () => process.exit(0));
+});
diff --git a/commons/lib/cut/render-edit.mjs b/commons/lib/cut/render-edit.mjs
new file mode 100644
index 0000000..da43468
--- /dev/null
+++ b/commons/lib/cut/render-edit.mjs
@@ -0,0 +1,61 @@
+// Cohabi Cut, Job 4: the render runner.
+//
+// renderTimeline({ tracks, sources, width, height, outPath, run, ffmpeg, timeoutMs })
+//   1. buildRenderPlan() (the planner on main) turns `tracks` into ffmpeg input args + a filter graph.
+//   2. ffmpeg -y <plan.args> -c:v libx264 -pix_fmt yuv420p -c:a aac <outPath> is run with an ARGV
+//      ARRAY (never a shell string). `run` defaults to child_process.spawnSync and is injectable for tests.
+//   3. Returns { ok: true, outPath, durationTicks, ignored }. On ffmpeg exit != 0 (or a failed spawn, or
+//      a timeout) it throws an Error whose message ends with the last 20 stderr lines.
+//
+// The caller owns the paths: `tracks` must already carry SERVER-SIDE file paths in params.src (the
+// planner's own contract), and `outPath` must be a server-chosen path. This module refuses an outPath
+// that is not a non-empty single-line string or that starts with "-" (it would be read as an option).
+// No server.mjs, no network, no file reads: this module only builds argv and runs the process.
+//
+// Import path: written to run from teams/cut/editor/. When placed at commons/lib/cut/render-edit.mjs
+// change the plan import to "./plan.mjs".
+
+import { spawnSync } from "node:child_process";
+import { buildRenderPlan } from "./plan.mjs";
+
+export const VIDEO_CODEC_ARGS = Object.freeze(["-c:v", "libx264", "-pix_fmt", "yuv420p", "-c:a", "aac"]);
+export const STDERR_TAIL_LINES = 20;
+
+function tail(text, n = STDERR_TAIL_LINES) {
+	const lines = String(text ?? "").split(/\r?\n/);
+	while (lines.length && lines[lines.length - 1] === "") lines.pop();
+	return lines.slice(-n).join("\n");
+}
+
+// The full ffmpeg argv for a plan (exported so tests and callers can inspect it without running anything).
+export function buildFfmpegArgs(plan, outPath) {
+	if (typeof outPath !== "string" || outPath.length === 0 || /[\0\r\n]/.test(outPath) || outPath.startsWith("-")) {
+		throw new TypeError("outPath must be a non-empty single-line path that does not start with '-'");
+	}
+	return ["-y", ...plan.args, ...VIDEO_CODEC_ARGS, outPath];
+}
+
+export function renderTimeline({
+	tracks,
+	sources = {},
+	width = 1080,
+	height = 1920,
+	outPath,
+	run = spawnSync,
+	ffmpeg = process.env.FFMPEG || "ffmpeg",
+	timeoutMs = 10 * 60 * 1000,
+} = {}) {
+	// Planner errors (RenderPlanError) propagate unchanged: they are the user-facing refusals.
+	const plan = buildRenderPlan({ tracks, sources, width, height });
+	const argv = buildFfmpegArgs(plan, outPath);
+	const r = run(ffmpeg, argv, { encoding: "utf8", maxBuffer: 64 * 1024 * 1024, timeout: timeoutMs });
+	if (r?.error) {
+		const why = r.error.code === "ETIMEDOUT" ? `timed out after ${timeoutMs} ms` : `could not start (${r.error.code ?? r.error.message})`;
+		throw new Error(`ffmpeg ${why}`);
+	}
+	if (!r || r.status !== 0) {
+		const code = r?.status ?? (r?.signal ? `signal ${r.signal}` : "unknown");
+		throw new Error(`ffmpeg exited with ${code}\n${tail(r?.stderr)}`);
+	}
+	return { ok: true, outPath, durationTicks: plan.durationTicks, ignored: plan.ignored };
+}
diff --git a/commons/lib/cut/render-job.mjs b/commons/lib/cut/render-job.mjs
new file mode 100644
index 0000000..aa8082f
--- /dev/null
+++ b/commons/lib/cut/render-job.mjs
@@ -0,0 +1,103 @@
+// Cohabi Cut, Job 4: the one call POST /api/cut/render makes.
+//
+// renderEditJob({ edit, video, music = null, outDir, run = spawnSync, ffmpeg, timeoutMs })
+//   edit   what the phone sent: { trimStart, trimEnd, text?{body,y}, music?{id,volume}, coverSec }
+//   video  { path, durationSec, width, height, hasAudio? }  looked up BY THE ROUTE from the client's video id.
+//          `path` must be an absolute path to an existing file. width/height are the OUTPUT frame
+//          (rounded down to even numbers, 16..4096). `hasAudio` defaults to true, as in the planner: a silent
+//          source must say `hasAudio: false` or ffmpeg will fail on the missing audio stream (loudly, not silently).
+//   music  { path } looked up by the route from edit.music.id, or null. Absolute path to an existing file.
+//   outDir an absolute path to an existing directory the route owns. The output is a random cut_<16 hex>.mp4 in it.
+//   returns { ok: true, outPath, seconds }   seconds = length of the rendered (trimmed) video.
+//
+// Order: validate everything and run editToTracks first (so a bad edit never reaches ffmpeg), then renderTimeline.
+// Refusals throw TypeError/RangeError with a plain message (the route turns them into a 400); an ffmpeg failure
+// throws the runner's Error (the route turns that into a 500) and any half-written output file is removed.
+//
+// Refuses: a trimmed length over 60 s; an outDir that is not an absolute existing directory; a video.path or
+// music.path that is not an absolute existing file; edit.music with no music file given.
+// If `music` is given but edit.music is absent, the music is ignored (nothing to mix at, no volume to use).
+//
+// Import path: same folder as edit.mjs and render-edit.mjs, so placing the three together at commons/lib/cut/
+// needs no change here (edit.mjs and render-edit.mjs each have their own one-line import change).
+
+import { spawnSync } from "node:child_process";
+import { randomBytes } from "node:crypto";
+import { existsSync, statSync, unlinkSync } from "node:fs";
+import { isAbsolute, join } from "node:path";
+import { editToTracks } from "./edit.mjs";
+import { renderTimeline } from "./render-edit.mjs";
+
+export const MAX_RENDER_SECONDS = 60;
+export const MAX_SIDE_PX = 4096;
+export const MIN_SIDE_PX = 16;
+
+function stat(p) {
+	try { return statSync(p); } catch { return null; }
+}
+
+function absoluteFile(name, p) {
+	if (typeof p !== "string" || p.length === 0 || /[\0\r\n]/.test(p)) throw new TypeError(`${name} must be a non-empty single-line path`);
+	if (!isAbsolute(p)) throw new TypeError(`${name} must be an absolute path`);
+	const s = stat(p);
+	if (!s || !s.isFile()) throw new TypeError(`${name} must be an existing file`);
+	return p;
+}
+
+function side(name, v) {
+	if (!Number.isFinite(v)) throw new TypeError(`${name} must be a finite number`);
+	const even = Math.floor(v / 2) * 2;
+	if (even < MIN_SIDE_PX || even > MAX_SIDE_PX) throw new RangeError(`${name} must be from ${MIN_SIDE_PX} to ${MAX_SIDE_PX} pixels, got ${v}`);
+	return even;
+}
+
+export function renderEditJob({
+	edit,
+	video,
+	music = null,
+	outDir,
+	run = spawnSync,
+	ffmpeg = process.env.FFMPEG || "ffmpeg",
+	timeoutMs,
+} = {}) {
+	if (!video || typeof video !== "object") throw new TypeError("video must be an object { path, durationSec, width, height }");
+	const videoPath = absoluteFile("video.path", video.path);
+	if (!Number.isFinite(video.durationSec) || video.durationSec <= 0) throw new RangeError("video.durationSec must be a number greater than 0");
+	const width = side("video.width", video.width);
+	const height = side("video.height", video.height);
+	if (video.hasAudio !== undefined && typeof video.hasAudio !== "boolean") throw new TypeError("video.hasAudio must be true or false when given");
+
+	if (typeof outDir !== "string" || !isAbsolute(outDir)) throw new TypeError("outDir must be an absolute path");
+	const d = stat(outDir);
+	if (!d || !d.isDirectory()) throw new TypeError("outDir must be an existing directory");
+
+	let musicPath;
+	if (music !== null && music !== undefined) {
+		if (typeof music !== "object") throw new TypeError("music must be an object { path } or null");
+		musicPath = absoluteFile("music.path", music.path);
+	}
+	const wantsMusic = edit && typeof edit === "object" && edit.music !== undefined && edit.music !== null;
+	if (wantsMusic && musicPath === undefined) throw new TypeError("the edit asks for music but no music file was given");
+
+	// Validates the whole edit (trim, text, music volume, cover) before anything else happens.
+	const tracks = editToTracks(edit, {
+		durationSec: video.durationSec,
+		width,
+		height,
+		videoSrc: videoPath,
+		musicSrc: wantsMusic ? musicPath : undefined,
+	});
+
+	const seconds = edit.trimEnd - edit.trimStart;
+	if (seconds > MAX_RENDER_SECONDS) throw new RangeError(`the trimmed video is ${seconds.toFixed(1)} s; the limit is ${MAX_RENDER_SECONDS} s`);
+
+	const sources = { [videoPath]: { hasAudio: video.hasAudio !== false, width: video.width, height: video.height } };
+	const outPath = join(outDir, `cut_${randomBytes(8).toString("hex")}.mp4`);
+	try {
+		const res = renderTimeline({ tracks, sources, width, height, outPath, run, ffmpeg, ...(timeoutMs ? { timeoutMs } : {}) });
+		return { ok: true, outPath: res.outPath, seconds };
+	} catch (err) {
+		try { if (existsSync(outPath)) unlinkSync(outPath); } catch { /* best effort */ }
+		throw err;
+	}
+}
diff --git a/commons/lib/cut/route.mjs b/commons/lib/cut/route.mjs
new file mode 100644
index 0000000..3717b74
--- /dev/null
+++ b/commons/lib/cut/route.mjs
@@ -0,0 +1,131 @@
+// Cohabi Cut, Job 4: the handler POST /api/cut/render calls.
+//
+// handleCutRender({ member, body, deps }) -> Promise<{ status, json }>
+//
+//   member  the signed-in member (route already authenticated): { id }. No member id -> 401.
+//   body    parsed JSON from the phone: { videoId, edit, musicId? }.
+//   deps    everything the handler touches, so server.mjs stays three lines and tests need no server:
+//     videos.get(id)   -> null | { owner, path, durationSec, width, height, hasAudio? }
+//     music.get(id)    -> null | { owner?, public?, path }     (only needed when music is asked for)
+//     probe(path)      -> boolean | { hasAudio }               optional; when absent the video record's hasAudio is used
+//     outDir           absolute existing directory (renders go here as cut_<16hex>.mp4)
+//     publicUrl(outPath) -> string                              optional; default "/cut/<basename>" (the server must serve it)
+//     renderJob(args)  -> result | Promise<result>              optional; default renderEditJob from ./render-job.mjs
+//     maxJobs          site-wide simultaneous renders, default 2
+//     log(msg)         optional, gets the real error text of a failed render (never sent to the client)
+//
+// Answers:
+//   200 { ok:true, url, seconds }
+//   400 bad body / bad ids / the edit refused (the refusal's own message)
+//   401 no member
+//   403 the video (or music) is not yours
+//   404 no such video / music
+//   422 the server could not read the video's audio
+//   429 "one export at a time" (this member already has a render) | "the editor is busy, try again in a minute" (site cap)
+//   500 "the render failed" (the ffmpeg text goes to deps.log only)
+//
+// Order: validate -> look up + ownership -> concurrency slots -> probe -> render. Slots are always released.
+//
+// IMPORTANT FOR THE WIRING: renderEditJob / renderTimeline call ffmpeg with spawnSync by default. A synchronous render
+// blocks the Node event loop, so while it runs no second request is even read and the 429 guards cannot fire. The
+// guards are real only if deps.renderJob runs ffmpeg off the event loop (a child process or worker returning a promise).
+// With the default renderJob they are still correct, just idle.
+
+import { basename } from "node:path";
+import { renderEditJob } from "./render-job.mjs";
+
+export const DEFAULT_MAX_JOBS = 2;
+const MAX_ID_LEN = 200;
+
+// Per-process counters. One map entry per member with a render running; `active` is the site-wide count.
+const memberBusy = new Set();
+let active = 0;
+
+export function _resetCutRouteState() { memberBusy.clear(); active = 0; }
+export function _cutRouteState() { return { members: [...memberBusy], active }; }
+
+const reply = (status, json) => ({ status, json });
+const fail = (status, error) => reply(status, { ok: false, error });
+
+function goodId(v) {
+	return typeof v === "string" && v.length > 0 && v.length <= MAX_ID_LEN && !/[\0\r\n]/.test(v);
+}
+
+export async function handleCutRender({ member, body, deps } = {}) {
+	if (!member || !goodId(member.id)) return fail(401, "sign in to export");
+	if (!deps || typeof deps !== "object" || !deps.videos || typeof deps.videos.get !== "function") {
+		return fail(500, "the editor is not set up on this server");
+	}
+	if (!body || typeof body !== "object" || Array.isArray(body)) return fail(400, "send { videoId, edit }");
+	const { videoId, edit } = body;
+	if (!goodId(videoId)) return fail(400, "videoId is required");
+	if (!edit || typeof edit !== "object" || Array.isArray(edit)) return fail(400, "edit is required");
+	if (body.musicId !== undefined && body.musicId !== null && !goodId(body.musicId)) return fail(400, "musicId must be a short text id");
+	const musicId = body.musicId ?? (edit.music && typeof edit.music === "object" ? edit.music.id : undefined);
+	if (musicId !== undefined && musicId !== null && !goodId(musicId)) return fail(400, "music id must be a short text id");
+	// Only fetch music when the edit actually mixes it; the job ignores music without edit.music.
+	const wantsMusic = edit.music !== undefined && edit.music !== null;
+	if (wantsMusic && !musicId) return fail(400, "the edit asks for music but gives no music id");
+
+	const video = await deps.videos.get(videoId); // await: the server's adapter may be async (real stores are sync, fakes too)
+	if (!video) return fail(404, "no such video");
+	if (video.owner !== member.id) return fail(403, "that video is not yours");
+
+	let music = null;
+	if (wantsMusic) {
+		if (!deps.music || typeof deps.music.get !== "function") return fail(400, "music is not available on this server");
+		const m = await deps.music.get(musicId);
+		if (!m) return fail(404, "no such music");
+		// Label tracks are public: they say so explicitly. Everything else must be the member's own.
+		if (m.public !== true && m.owner !== member.id) return fail(403, "that music is not yours");
+		music = { path: m.path };
+	}
+
+	const maxJobs = Number.isInteger(deps.maxJobs) && deps.maxJobs > 0 ? deps.maxJobs : DEFAULT_MAX_JOBS;
+	if (memberBusy.has(member.id)) return fail(429, "one export at a time");
+	if (active >= maxJobs) return fail(429, "the editor is busy, try again in a minute");
+	memberBusy.add(member.id);
+	active += 1;
+	try {
+		let hasAudio = video.hasAudio;
+		const dims = {}; // measured by deps.probe AFTER the ownership check; the store's record has no width/height
+		if (typeof deps.probe === "function") {
+			try {
+				const p = await deps.probe(video.path);
+				hasAudio = typeof p === "boolean" ? p : p && typeof p === "object" ? p.hasAudio : undefined;
+				if (p && typeof p === "object") for (const k of ["durationSec", "width", "height"]) if (Number.isFinite(p[k]) && p[k] > 0) dims[k] = p[k];
+			} catch (err) {
+				if (typeof deps.log === "function") deps.log(`cut probe failed: ${err && err.message}`);
+				return fail(422, "could not read that video");
+			}
+			if (typeof hasAudio !== "boolean") return fail(422, "could not read that video");
+		}
+
+		const job = {
+			edit,
+			video: {
+				path: video.path, durationSec: video.durationSec, width: video.width, height: video.height,
+				...dims,
+				...(typeof hasAudio === "boolean" ? { hasAudio } : {}),
+			},
+			music,
+			outDir: deps.outDir,
+		};
+		let res;
+		try {
+			res = await (typeof deps.renderJob === "function" ? deps.renderJob(job) : renderEditJob(job));
+		} catch (err) {
+			// TypeError/RangeError are the job's own refusals (bad edit, bad file, too long): safe to show.
+			if (err instanceof TypeError || err instanceof RangeError || (err && err.name === "RenderPlanError")) {
+				return fail(400, String(err.message || "the edit was refused"));
+			}
+			if (typeof deps.log === "function") deps.log(`cut render failed: ${err && err.message}`);
+			return fail(500, "the render failed");
+		}
+		const url = typeof deps.publicUrl === "function" ? deps.publicUrl(res.outPath) : `/cut/${basename(res.outPath)}`;
+		return reply(200, { ok: true, url, seconds: res.seconds });
+	} finally {
+		memberBusy.delete(member.id);
+		active -= 1;
+	}
+}
diff --git a/commons/lib/cut/wire.mjs b/commons/lib/cut/wire.mjs
new file mode 100644
index 0000000..606d630
--- /dev/null
+++ b/commons/lib/cut/wire.mjs
@@ -0,0 +1,72 @@
+// Cohabi Cut, Job 4: the glue between route.mjs and the server's real stores. Pure functions of the stores handed in,
+// so a test can pass stores with the same SHAPES as commons/lib/videos.mjs and commons/lib/audio.mjs.
+//
+// What main's stores actually give (read at commons/lib/videos.mjs and audio.mjs, 2026-11-23):
+//   videos.get(id)     -> { id, by, url, seconds|null, ready, ... }   owner is `by`; NO file path, NO width/height
+//   videos.fileFor(id) -> { file, type } | null                      the file to read (converted mp4, else the original)
+//   audio.get(id)      -> { id, ext, by, title, ... } | null         owner is `by`
+//   audio.fileOf(item) -> absolute path
+// route.mjs wants { owner, path } from videos.get / music.get and { hasAudio, width, height, durationSec } from probe.
+import { execFile, fork } from "node:child_process";
+import { basename, isAbsolute } from "node:path";
+
+const run = (impl, file, args) => new Promise((res, rej) => {
+	impl(file, args, { timeout: 20000, maxBuffer: 1 << 20 }, (e, so) => (e ? rej(e) : res(String(so))));
+});
+
+/** Parse `ffprobe -print_format json -show_streams -show_format` output into what the editor needs. */
+export function parseProbe(json) {
+	const j = typeof json === "string" ? JSON.parse(json) : json;
+	const streams = Array.isArray(j?.streams) ? j.streams : [];
+	const v = streams.find((s) => s.codec_type === "video");
+	if (!v) throw new Error("no video stream");
+	let w = Number(v.width), h = Number(v.height);
+	// Phones record sideways and add a rotation flag; ffmpeg auto-rotates, so the frame the editor sees is swapped.
+	const rot = Number((v.side_data_list || []).map((d) => d?.rotation).find((r) => r !== undefined) ?? v.tags?.rotate ?? 0);
+	if (Math.abs(rot) % 180 === 90) [w, h] = [h, w];
+	const dur = Number(j?.format?.duration ?? v.duration);
+	if (!(w > 0) || !(h > 0) || !(dur > 0)) throw new Error("unreadable video");
+	return { hasAudio: streams.some((s) => s.codec_type === "audio"), width: w, height: h, durationSec: dur };
+}
+
+export function makeCutDeps({ videos, audio, labelTracks = null, outDir, ffprobe = process.env.FFPROBE || "ffprobe", execFileImpl = execFile, maxJobs = 2, renderJob = forkRenderJob, log = () => {} } = {}) {
+	return {
+		videos: {
+			get(id) {
+				const v = videos.get(id), f = videos.fileFor(id);
+				return v && f ? { owner: v.by, path: f.file } : null;
+			},
+		},
+		music: {
+			get(id) {
+				if (labelTracks) { const t = labelTracks.get(id); if (t) return { public: true, path: t.path }; }
+				const a = audio.get(id);
+				return a ? { owner: a.by, path: audio.fileOf(a) } : null;
+			},
+		},
+		async probe(path) {
+			if (!isAbsolute(path)) throw new Error("probe wants an absolute path");
+			return parseProbe(await run(execFileImpl, ffprobe, ["-v", "error", "-print_format", "json", "-show_streams", "-show_format", path]));
+		},
+		outDir, maxJobs, renderJob, log,
+		publicUrl: (outPath) => `/cut/${basename(outPath)}`,
+	};
+}
+
+/** Run renderEditJob in a child process so ffmpeg's spawnSync never blocks the server; refusals keep their type. */
+export function forkRenderJob(job, { timeoutMs = 150000, child = new URL("./render-child.mjs", import.meta.url) } = {}) {
+	return new Promise((resolve, reject) => {
+		const p = fork(child, [], { stdio: ["ignore", "ignore", "ignore", "ipc"], execArgv: [] });
+		let done = false;
+		const end = (fn, v) => { if (done) return; done = true; clearTimeout(t); try { p.kill(); } catch { /* already gone */ } fn(v); };
+		const t = setTimeout(() => end(reject, new Error("render timed out")), timeoutMs);
+		p.once("message", (m) => {
+			if (m?.ok) return end(resolve, m.result);
+			const e = m?.name === "TypeError" ? new TypeError(m.message) : m?.name === "RangeError" ? new RangeError(m.message) : Object.assign(new Error(m?.message || "render failed"), { name: m?.name || "Error" });
+			end(reject, e);
+		});
+		p.once("error", (e) => end(reject, e));
+		p.once("exit", () => end(reject, new Error("render process exited")));
+		p.send(job);
+	});
+}
diff --git a/commons/lib/cut/wrap.mjs b/commons/lib/cut/wrap.mjs
new file mode 100644
index 0000000..3b56599
--- /dev/null
+++ b/commons/lib/cut/wrap.mjs
@@ -0,0 +1,100 @@
+// Cohabi Cut Job 3 follow-up: wrap long Words captions so they stay inside the frame.
+// ffmpeg drawtext never wraps: on 2026-11-21 an 8-word caption's bright pixels reached x=534 of 540.
+// This module splits a caption into lines BEFORE ffmpeg, one drawtext per line, so the registry stays
+// the only drawtext serializer and never has to accept a line break inside a value.
+//
+// Width estimate: advance widths of DejaVu Sans (units per 1000 em, ASCII 0x20..0x7e, measured with
+// PIL ImageFont.getlength at size 1000 on 2026-11-21). The table fits ONLY DejaVu Sans. An earlier
+// version of this comment claimed DejaVu is among the widest sans fonts so an unknown `sans` would err
+// toward early wrapping; that was FALSE (measured 2026-11-21, 10 x "W" at 48 px: bright x-extent 2..472
+// under DejaVu but 1..495 under a Lato default). So every caption this module returns is PINNED to
+// WRAP_FONT (`font=DejaVu Sans`), wrapped or not: the font drawtext uses is then the one measured here,
+// whatever the server's fontconfig default is. Characters outside ASCII are assumed 1.0 em (as wide
+// as a CJK glyph). The estimate was checked against real drawtext pixel bounds in
+// teams/cut/render/ffmpeg-smoke-wrap.py and a test here. The server must have DejaVu Sans installed;
+// if fontconfig substitutes another face, the width guarantee is gone (check `fc-match "DejaVu Sans"`).
+
+export const WRAP_FONT = "DejaVu Sans";
+
+export const DEJAVU_ADVANCE = [
+	318, 401, 460, 838, 636, 950, 780, 275, 390, 390, 500, 838, 318, 361, 318, 337, 636, 636, 636, 636,
+	636, 636, 636, 636, 636, 636, 337, 337, 838, 838, 838, 531, 1000, 684, 686, 698, 770, 632, 575, 775,
+	752, 295, 295, 656, 557, 863, 748, 787, 603, 787, 695, 635, 611, 732, 684, 989, 685, 611, 685, 390,
+	337, 390, 838, 500, 500, 613, 635, 550, 635, 615, 352, 635, 634, 278, 278, 579, 278, 974, 634, 612,
+	635, 635, 411, 521, 392, 634, 592, 818, 592, 592, 525, 636, 337, 636, 838,
+];
+
+export const LINE_HEIGHT_FACTOR = 1.2;
+export const RIGHT_MARGIN_FRACTION = 0.04;
+
+/** Estimated rendered width in pixels of a single line at `fontSize`. */
+export function estimateTextWidth(text, fontSize) {
+	let units = 0;
+	for (const ch of String(text)) {
+		const c = ch.codePointAt(0);
+		units += c >= 0x20 && c <= 0x7e ? DEJAVU_ADVANCE[c - 0x20] : 1000;
+	}
+	return (units * fontSize) / 1000;
+}
+
+/** Greedy word wrap to `maxWidth` pixels. A word wider than the line is split by character. */
+export function wrapLines(text, fontSize, maxWidth) {
+	if (estimateTextWidth(text, fontSize) <= maxWidth) return [text];
+	const lines = [];
+	let line = "";
+	const fits = (s) => estimateTextWidth(s, fontSize) <= maxWidth;
+	for (const word of text.split(/ +/).filter((w) => w.length > 0)) {
+		let rest = word;
+		while (!fits(rest)) {
+			// hard split: longest prefix that fits, at least one character
+			const chars = [...rest];
+			let n = chars.length - 1;
+			while (n > 1 && !fits(chars.slice(0, n).join(""))) n--;
+			if (line) { lines.push(line); line = ""; }
+			lines.push(chars.slice(0, n).join(""));
+			rest = chars.slice(n).join("");
+		}
+		if (!line) line = rest;
+		else if (fits(`${line} ${rest}`)) line = `${line} ${rest}`;
+		else { lines.push(line); line = rest; }
+	}
+	if (line) lines.push(line);
+	return lines;
+}
+
+/**
+ * Turn one text-effect params object into one params object per wrapped line.
+ * Every returned object carries `font: WRAP_FONT` (see header), including a caption that fits on one line.
+ * Throws RangeError when it cannot fit the frame.
+ */
+export function wrapCaptionParams(params, { width, height }) {
+	const { text, x = 0, y = 0, fontSize = 32 } = params;
+	if (typeof text !== "string" || !Number.isFinite(x) || !Number.isFinite(y) || !Number.isFinite(fontSize) || fontSize <= 0) {
+		return [params]; // let the registry produce its own precise error
+	}
+	// Top-left pixel origin: a negative x or y puts the first glyphs off the left/top edge. Before this check
+	// a negative x also WIDENED maxWidth, so a caption at x=-200 wrapped as if the frame were 200 px wider.
+	if (x < 0 || y < 0) {
+		throw new RangeError(`caption origin (${x}, ${y}) is outside the frame: x and y are top-left pixels and must be >= 0`);
+	}
+	const margin = Math.round(width * RIGHT_MARGIN_FRACTION);
+	const maxWidth = width - x - margin;
+	if (estimateTextWidth(text, fontSize) <= maxWidth) {
+		// A caption that fits on one line is still checked against the bottom edge (same line-box rule as wrapped lines).
+		const oneLine = Math.ceil(fontSize * LINE_HEIGHT_FACTOR);
+		if (y + oneLine > height) {
+			throw new RangeError(`caption at y=${y} needs a ${oneLine}px line box (bottom edge ${y + oneLine}px) but the frame is ${height}px tall`);
+		}
+		return [{ ...params, font: WRAP_FONT }];
+	}
+	if (maxWidth < fontSize) {
+		throw new RangeError(`caption at x=${x} leaves ${maxWidth}px of a ${width}px frame, less than one ${fontSize}px glyph`);
+	}
+	const lines = wrapLines(text, fontSize, maxWidth);
+	const lineHeight = Math.ceil(fontSize * LINE_HEIGHT_FACTOR);
+	const bottom = y + (lines.length - 1) * lineHeight + lineHeight;
+	if (bottom > height) {
+		throw new RangeError(`caption needs ${lines.length} lines (bottom edge ${bottom}px) but the frame is ${height}px tall`);
+	}
+	return lines.map((line, i) => ({ ...params, text: line, y: y + i * lineHeight, font: WRAP_FONT }));
+}
