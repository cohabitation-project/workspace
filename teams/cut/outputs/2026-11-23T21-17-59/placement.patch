+    return renderEditJob({ ...job, ffmpeg: 'ffmpeg-fake', run: (cmd, argv) => { note({ kind: 'ffmpeg', cmd, argv }); fs.writeFileSync(argv[argv.length - 1], 'FAKE-MP4-BYTES'); return { status: 0, stdout: '', stderr: '' }; } });
+  },
+};
+`;
