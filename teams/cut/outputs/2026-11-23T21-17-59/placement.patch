+	s = insertAfter(s, "videos.init(DATA);", HUNK.B.map((l) => l.replace(B_ORIG, B_INJECTED)));
+	s = insertAfter(s, "app.delete('/api/videos/:id'", HUNK.C);
+	s = insertAfter(s, "app.get('/videos/:id/poster.jpg'", [...HUNK.E, ...HUNK.D]);
+	return s;
