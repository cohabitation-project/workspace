+
+// Round 30 (Cut Claude): a saved draft is restored on loadedmetadata; its cover must be pulled into its trim there too.
+function bootWithDraft(draft) {
+  const store = { 'cohabi-cut-draft:unassigned': JSON.stringify(draft) };
+  const saved = globalThis.localStorage;
+  globalThis.localStorage = { getItem: (k) => store[k] ?? null, setItem: (k, v) => { store[k] = String(v); } };
+  try { return bootEditor(); } finally { globalThis.localStorage = saved; }
+}
+
+test('a draft saved with trim 2..4 and cover 0 loads with the scrubber at 2', () => {
+  const els = bootWithDraft({ trimStart: 2, trimEnd: 4, coverSec: 0 });
+  loadClip(els, 6);
+  assert.equal(els['trim-start'].value, '2');
+  assert.equal(els['trim-end'].value, '4');
+  assert.equal(els['cover-scrub'].value, '2');
+});
+
+test('a draft cover inside its trim is restored as saved, and one past the trim end loads at the end', () => {
+  let els = bootWithDraft({ trimStart: 2, trimEnd: 4, coverSec: 3 });
+  loadClip(els, 6);
+  assert.equal(els['cover-scrub'].value, '3');
+  els = bootWithDraft({ trimStart: 2, trimEnd: 4, coverSec: 5.5 });
+  loadClip(els, 6);
+  assert.equal(els['cover-scrub'].value, '4');
+});
