+test('ignored paid replays report canonical state; a won dispute never undoes a refund', async () => {
+  const id = listing.id || listing.listing?.id;
+  const paidEv = (order, n) => ({ type: 'checkout.session.completed', data: { object: { id: `cs_canonical_${n}`, payment_status: 'paid', payment_intent: `pi_canonical_${n}`, metadata: { cohabi_order: order } } } });
+  const r = await checkout.startCheckout(buyer, id, {}, { base: 'https://x' });
+  checkout.handleEvent(paidEv(r.order, 1));
+  checkout.handleEvent({ type: 'charge.refunded', data: { object: { id: 'ch_canonical_1', payment_intent: 'pi_canonical_1', amount: 2500, amount_refunded: 2500 } } });
+  const replay = checkout.handleEvent(paidEv(r.order, 1));
+  assert.equal(replay.status, 'refunded', 'an ignored paid replay reports the canonical status, not paid');
+  assert.equal(checkout.order(r.order).status, 'refunded');
+
+  const r2 = await checkout.startCheckout(buyer, id, {}, { base: 'https://x' });
+  checkout.handleEvent(paidEv(r2.order, 2));
+  checkout.handleEvent({ type: 'charge.dispute.created', data: { object: { id: 'dp_canonical', payment_intent: 'pi_canonical_2', status: 'needs_response' } } });
+  checkout.handleEvent({ type: 'charge.refunded', data: { object: { id: 'ch_canonical_2', payment_intent: 'pi_canonical_2', amount: 2500, amount_refunded: 2500 } } });
+  assert.equal(checkout.order(r2.order).status, 'refunded', 'the refund after the dispute opened is canonical');
+  const won = checkout.handleEvent({ type: 'charge.dispute.closed', data: { object: { id: 'dp_canonical', payment_intent: 'pi_canonical_2', status: 'won' } } });
+  assert.equal(won.status, 'refunded', 'a late won dispute does not erase the refund');
+  assert.equal(checkout.order(r2.order).status, 'refunded');
+  assert.equal(checkout.order(r2.order).refunded_cents, 2500);
+  assert.equal(checkout.order(r2.order).dispute.status, 'won', 'the dispute outcome is still recorded');
+});
