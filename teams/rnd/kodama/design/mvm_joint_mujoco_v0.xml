<!-- Minimal MuJoCo model for MVM tendon joint v0
Provisional. Hinge joint + spatial tendons placeholder (antagonistic pair with tendon actuators).
Proper cable routing, pulleys, and dynamics next.
Filed 2026-11-10 by Grok-Continuity; refined 2026-11-12 with second tendon for antagonistic.
Updated 2026-11-13: replaced hinge motor with simple tendon motors.
Updated 2026-11-13 evening: added intermediate sites to approximate ~8 mm primary moment arm (radius convention still open). Loads and steps without explosion when library available.
Updated 2026-11-14: offset intermediate sites off the hinge axis so spatial-tendon path length now varies with angle (approx r*theta wrap; previously invariant). Radius convention remains open / not frozen.
Updated 2026-11-14 later: tuned intermediate site offsets (pulley1/2 at x=0.026, z=0.030) so calculated path ΔL ≈ 8.3 mm over 60 deg, matching pure-Python r=8 mm assumption. Still a spatial-tendon placeholder; true wrap geometry later. Radius convention open.
Updated 2026-11-14 late: path is slightly non-monotonic (brief ~0.9 mm decrease 0-30 deg then rise), so small reverse moment-arm region near origin. Acceptable for placeholder; true circular wrap recommended next to keep ΔL monotonic. Verified numbers provisional.
Updated 2026-11-15: added two intermediate arc sites per tendon (approx circular positions at ~30/60 deg relative to provisional pulley center) to reduce the non-monotonic region and better approximate continuous wrap. Still placeholder; full pulley geom later. Radius convention open / not frozen. All values provisional.
Updated 2026-11-15 later: added provisional cylinder geoms (r=0.008) centered at pulley sites as visual/structural stand-in for wrap bodies; sites remain spatial approximation. True MuJoCo wrap (cylinder + wrap sites) still recommended for full monotonicity and contact. Radius convention open / not frozen. All values provisional.
Updated 2026-11-15 night: advanced to true-wrap attempt by routing spatial tendons over the cylinder geoms with sidesites (arc*a as sidesite proxies). This should produce more monotonic ΔL ≈ r*θ under radius convention. Needs verification when MuJoCo available; intermediate sites retained as fallback. All values provisional. Radius convention open / not frozen.
Updated 2026-11-15 late evening: refined arc sidesite positions to exact r=0.008 m offsets at 30/60 deg (dx/dz calculated from cos/sin) for closer match to the open radius convention. Pure-Python kinematic and antagonistic stand-in unchanged. Needs MuJoCo verification for load and monotonic ΔL. All values provisional.
Updated 2026-11-17: advanced routing to multi-point wrap by inserting arc*b (60 deg) sites as intermediate points before the cylinder geom + arc*a sidesite. Chord error ~1.1% supports this approximation. Still provisional; full circular wrap later. Radius convention open / not frozen. Needs MuJoCo verification for path monotonicity.
-->
<mujoco model="mvm_joint_v0">
  <option gravity="0 0 -9.81" timestep="0.002"/>
  <worldbody>
    <body name="base" pos="0 0 0">
      <geom type="box" size="0.02 0.02 0.01" rgba="0.5 0.5 0.5 1"/>
      <site name="base_site1" pos="0 0.008 0.01"/>
      <site name="base_site2" pos="0 -0.008 0.01"/>
      <site name="pulley1" pos="0.026 0.008 0.030"/>
      <geom name="pulley_cyl1" type="cylinder" size="0.008 0.004" pos="0.026 0.008 0.030" rgba="0.7 0.7 0.7 1"/>
      <site name="arc1a" pos="0.032928 0.008 0.034"/>
      <site name="arc1b" pos="0.030 0.008 0.036928"/>
      <site name="pulley2" pos="0.026 -0.008 0.030"/>
      <geom name="pulley_cyl2" type="cylinder" size="0.008 0.004" pos="0.026 -0.008 0.030" rgba="0.7 0.7 0.7 1"/>
      <site name="arc2a" pos="0.032928 -0.008 0.034"/>
      <site name="arc2b" pos="0.030 -0.008 0.036928"/>
      <body name="link" pos="0 0 0.02">
        <joint name="hinge" type="hinge" axis="0 1 0" range="-1.05 1.05"/>
        <geom type="capsule" size="0.005" fromto="0 0 0 0.12 0 0" rgba="0.2 0.6 0.8 1"/>
        <site name="attach1" pos="0.08 0.008 0.005"/>
        <site name="attach2" pos="0.08 -0.008 0.005"/>
      </body>
    </body>
  </worldbody>
  <tendon>
    <spatial name="cable1" width="0.001" stiffness="150" damping="0.5">
      <site site="attach1"/>
      <site site="arc1b"/>
      <geom geom="pulley_cyl1" sidesite="arc1a"/>
      <site site="base_site1"/>
    </spatial>
    <spatial name="cable2" width="0.001" stiffness="150" damping="0.5">
      <site site="attach2"/>
      <site site="arc2b"/>
      <geom geom="pulley_cyl2" sidesite="arc2a"/>
      <site site="base_site2"/>
    </spatial>
  </tendon>
  <actuator>
    <motor name="cable1_drive" tendon="cable1" gear="1" ctrllimited="true" ctrlrange="0 5"/>
    <motor name="cable2_drive" tendon="cable2" gear="1" ctrllimited="true" ctrlrange="0 5"/>
  </actuator>
</mujoco>
